{
    "__python_version": "3.14",
    "__uv_version": "0.12.21",
    "__pre_commit_version": "4.6",
    "__ruff_version": "0.16.9",
    "__pytest_version": "9.1",
    "__ipykernel_version": "7.4",
    "__nbstripout_version": "0.9.1",
    "project_name": "Project",
    "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-') }}",
    "module_name": "{{ cookiecutter.project_slug.replace('-', '_') }}",
    "use_ruff_format": true,
    "use_ruff_lint": true,
    "use_pytest": true,
    "use_nbstripout": true,
    "use_uv": true,
    "ci_platform": ["gitlab", "github", "none"],
    "__prompts__": {
        "project_name": "Project name, Title Case",
        "project_slug": "Repository name, kebab-case",
        "module_name": "Python module name, snake_case",
        "use_ruff_format": "Enable code formatting, using Ruff",
        "use_ruff_lint": "Enable code linting, using Ruff",
        "use_pytest": "Enable unit testing, using pytest",
        "use_nbstripout": "Strip notebook outputs on commit, using nbstripout",
        "use_uv": "Use uv instead of pip",
        "ci_platform": {
            "__prompt__": "Continuous integration platform",
            "gitlab": "GitLab CI/CD",
            "github": "GitHub Actions",
            "none": "None"
        }
    }
}
